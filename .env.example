# Copie para `.env` (que o git ignora) e ajuste. Todos os valores abaixo já são o padrão do compose.
# Nunca versione senhas reais.

# PostgreSQL
POSTGRES_DB=autorizador
POSTGRES_USER=autorizador
POSTGRES_PASSWORD=autorizador
POSTGRES_PORT=5432

# API: conexão com o banco (perfil local aponta para o Postgres do compose)
DB_URL=jdbc:postgresql://localhost:5432/autorizador
DB_USERNAME=autorizador
DB_PASSWORD=autorizador

# Portas publicadas na máquina
API_PORT=8080
APP_PORT=4200

# API (opcional)
APP_ENV=local-docker
LOG_LEVEL_APP=INFO
