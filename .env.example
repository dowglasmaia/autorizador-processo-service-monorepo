# Copie para `.env` (que o git ignora) e ajuste.
# ATENÇÃO: todos os valores abaixo são SOMENTE DE DESENVOLVIMENTO. Nunca versione senhas ou segredos reais
# e troque todos eles fora da máquina local.

# PostgreSQL
POSTGRES_DB=autorizador
POSTGRES_USER=autorizador
POSTGRES_PASSWORD=autorizador
POSTGRES_PORT=5432

# API: conexão com o banco (perfil local aponta para o Postgres do compose)
DB_URL=jdbc:postgresql://localhost:5432/autorizador
DB_USERNAME=autorizador
DB_PASSWORD=autorizador

# Portas publicadas na máquina
API_PORT=8080
APP_PORT=4200

# API (opcional)
# SERVER_PORT e a porta do processo da API (o compose publica a 8080 do contêiner em API_PORT).
SERVER_PORT=8080
APP_ENV=local-docker
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
# Formato do log JSON: ecs, logstash ou gelf (o perfil local imprime texto)
LOG_FORMAT=ecs

# CORS: origens permitidas separadas por virgula (vazio = nenhuma; o curinga "*" e ignorado).
# O perfil local ja libera http://localhost:4200.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Autenticação JWT (a API só inicia com JWT_SECRET de no mínimo 32 bytes; o compose exige a variável)
# Valor SOMENTE DE DESENVOLVIMENTO (não use em outro ambiente): gere outro com `openssl rand -base64 48`.
JWT_SECRET=dev-somente-desenvolvimento-troque-este-segredo-0123456789
JWT_TTL_MINUTOS=60
# Primeiro usuário (criado só com a tabela vazia e as duas variáveis preenchidas).
# Deixe vazio para não criar; preencha localmente com um usuário de desenvolvimento.
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_SENHA=
