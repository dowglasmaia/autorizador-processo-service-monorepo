PORT=8080
# Banco de dados (usado a partir da etapa de persistência)
DB_URL=jdbc:postgresql://localhost:5432/autorizador
DB_USERNAME=autorizador
DB_PASSWORD=
APP_ENV=production
# Logs: JSON (ecs|logstash|gelf) em todos os perfis, exceto local (texto).
LOG_FORMAT=ecs
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
# Observabilidade (OpenTelemetry nativo do Spring Boot). Exportação desligada até habilitar:
TRACING_SAMPLING_PROBABILITY=0.1
OTEL_EXPORT_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
