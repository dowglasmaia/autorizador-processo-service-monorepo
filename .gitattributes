# Arquivos copiados para as imagens Docker ou executados no Linux precisam de fim de linha LF,
# mesmo em clones Windows com core.autocrlf=true (CRLF quebra o shebang do mvnw no build da imagem).
*.sh text eol=lf
mvnw text eol=lf
Dockerfile text eol=lf
*.inc text eol=lf
*.template text eol=lf
*.conf text eol=lf
