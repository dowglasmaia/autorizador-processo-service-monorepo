# Nginx do frontend (SPEC-13): SPA estática + proxy de /api/ para o serviço `api` do Compose.
# `add_header` não é herdado quando uma location declara o seu próprio; por isso os cabeçalhos
# de segurança ficam em security-headers.inc e são incluídos em TODA location que
# declara cabeçalhos próprios (cache), além do nível server.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript application/json
               application/xml image/svg+xml font/ttf font/otf;

    include /etc/nginx/conf.d/security-headers.inc;

    # Rotas da SPA: arquivo, diretório ou fallback para index.html.
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }

    # index.html nunca em cache (referencia os arquivos com hash da versão atual).
    location = /index.html {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    # Arquivos com hash no nome (main-*.js, chunk-*.js, styles-*.css) e fontes: cache longo.
    location ~* \.(?:js|css|woff2?|ttf|otf)$ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Demais estáticos sem hash (favicon, imagens): cache curto.
    location ~* \.(?:ico|png|jpg|jpeg|gif|svg|webp)$ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=3600" always;
        try_files $uri =404;
    }

    # Login: limite por IP (zona `login` em limites.conf). 429 com Retry-After; a API mantém seu limitador por e-mail+IP.
    location = /api/v1/auth/login {
        include /etc/nginx/conf.d/security-headers.inc;
        limit_req zone=login burst=${NGINX_LOGIN_BURST} nodelay;
        error_page 429 = @login_429;
        proxy_pass http://api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    # API: mesma origem, sem CORS. Sem fallback para index.html (404 da API continua 404).
    location /api/ {
        include /etc/nginx/conf.d/security-headers.inc;
        proxy_pass http://api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location @login_429 {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Retry-After "60" always;
        default_type application/problem+json;
        return 429 '{"type":"about:blank","title":"Muitas tentativas","status":429,"detail":"Muitas tentativas de login. Aguarde e tente novamente.","code":"MUITAS_TENTATIVAS"}';
    }

    # Healthcheck do próprio contêiner.
    location = /healthz {
        include /etc/nginx/conf.d/security-headers.inc;
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        return 200 'ok';
    }

    # Único caminho do actuator exposto (somente leitura); /actuator/env etc. caem em 404 abaixo.
    location = /actuator/health {
        include /etc/nginx/conf.d/security-headers.inc;
        limit_except GET HEAD { deny all; }
        proxy_pass http://api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
    }

    location /actuator/ {
        include /etc/nginx/conf.d/security-headers.inc;
        return 404;
    }
}
