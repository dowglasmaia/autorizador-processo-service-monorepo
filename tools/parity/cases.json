{
  "versao": 1,
  "descricao": "Golden cases B01-B17 da versão original (tag v0-original). Fonte: .specs/00-product-discovery/BASELINE_COMPORTAMENTO_ORIGINAL.md e .specs/01-architecture/API_CONTRACTS.md §4.",
  "convencoes": {
    "caminhos": "Caminhos de campo usam notação com pontos; '[]' percorre todos os itens de um array (ex.: '[].numProcedimento'). '$' é a raiz.",
    "estavel": "Mapa caminho -> valor exato esperado.",
    "conjuntos": "Mapa caminho -> lista comparada SEM ordem.",
    "conjuntosOrdenados": "Mapa caminho -> lista comparada COM ordem (usado na v1).",
    "contem": "Mapa caminho -> trecho de texto que deve estar contido no valor.",
    "ausentes": "Lista de caminhos que NÃO podem existir na resposta.",
    "volateis": "Campos observados que variam a cada execução e são ignorados na comparação.",
    "ordemExecucao": "Os casos rodam na ordem do campo 'ordem'. B06, B07 e B12 ficam no fim de cada grupo porque deixam a base suja.",
    "base": "A original usa H2 em memória: os casos não são idempotentes e exigem contêiner novo a cada execução."
  },
  "semente": {
    "numeros": [1234, 4567, 6789]
  },
  "casos": [
    {
      "id": "B01",
      "grupo": "procedimento",
      "ordem": 1,
      "descricao": "Dado a carga inicial do perfil test, quando listo os procedimentos, então recebo 200 com os 3 itens da semente, sexos como nomes (F, M) e idades sem ordem garantida.",
      "original": {
        "requisicao": { "metodo": "GET", "caminho": "/procedimentos" },
        "resposta": {
          "status": 200,
          "estavel": { "$.length": 3 },
          "conjuntos": {
            "[].numProcedimento": [1234, 4567, 6789]
          },
          "volateis": ["[].id", "[].idades (ordem)", "[].sexos (ordem)"],
          "observada": [
            { "id": 1, "numProcedimento": 1234, "sexos": ["F"], "idades": [20, 10] },
            { "id": 2, "numProcedimento": 4567, "sexos": ["M", "F"], "idades": [20, 30] },
            { "id": 3, "numProcedimento": 6789, "sexos": ["M", "F"], "idades": [10] }
          ]
        }
      },
      "normalizacoes": [
        "idades e sexos comparados como conjuntos (sem ordem) na original",
        "id da linha ignorado"
      ],
      "mapeamentoV1": {
        "requisicao": { "metodo": "GET", "caminho": "/api/v1/procedimentos" },
        "resposta": {
          "status": 200,
          "conjuntos": { "itens[].numProcedimento": [1234, 4567, 6789] },
          "conjuntosOrdenados": { "itens[numProcedimento=1234].idades": [10, 20] }
        }
      },
      "divergencia": "DIV-07"
    },
    {
      "id": "B02",
      "grupo": "procedimento",
      "ordem": 2,
      "descricao": "Dado um procedimento novo 9999 com sexos [1,2] e idades [18,30], quando cadastro, então recebo 201 sem corpo e com Location.",
      "original": {
        "requisicao": {
          "metodo": "POST",
          "caminho": "/procedimentos",
          "cabecalhos": { "Content-Type": "application/json" },
          "corpo": { "numProcedimento": 9999, "sexos": [1, 2], "idades": [18, 30] }
        },
        "resposta": {
          "status": 201,
          "corpoVazio": true,
          "volateis": ["Location (host e id)"],
          "observada": { "cabecalhos": { "Location": "http://localhost:18080/procedimentos/4" } }
        }
      },
      "normalizacoes": ["Location: só a presença do cabecalho é verificada"],
      "mapeamentoV1": {
        "requisicao": {
          "metodo": "POST",
          "caminho": "/api/v1/procedimentos",
          "corpo": { "numProcedimento": 9999, "sexos": ["M", "F"], "idades": [18, 30] }
        },
        "resposta": {
          "status": 201,
          "estavel": { "numProcedimento": 9999 },
          "conjuntos": { "sexos": ["M", "F"], "idades": [18, 30] },
          "cabecalhosPresentes": ["Location"]
        }
      },
      "divergencia": "DIV-03"
    },
    {
      "id": "B03",
      "grupo": "procedimento",
      "ordem": 3,
      "descricao": "Dado um cadastro com sexos [\"M\",\"F\"] (texto), quando envio, então recebo 400 do Spring: a entrada só aceita 1/2 (assimetria entrada x saída).",
      "original": {
        "requisicao": {
          "metodo": "POST",
          "caminho": "/procedimentos",
          "cabecalhos": { "Content-Type": "application/json" },
          "corpo": { "numProcedimento": 9998, "sexos": ["M", "F"], "idades": [18] }
        },
        "resposta": {
          "status": 400,
          "estavel": { "status": 400, "error": "Bad Request" },
          "contem": { "message": "Cannot deserialize value of type `java.lang.Integer` from String \"M\"" },
          "volateis": ["timestamp", "trace", "message (trecho após o primeiro ponto)"]
        }
      },
      "normalizacoes": ["timestamp e trace ignorados; message comparada por trecho"],
      "mapeamentoV1": {
        "requisicao": {
          "metodo": "POST",
          "caminho": "/api/v1/procedimentos",
          "corpo": { "numProcedimento": 9998, "sexos": ["M", "F"], "idades": [18] }
        },
        "resposta": { "status": 201, "estavel": { "numProcedimento": 9998 } }
      },
      "divergencia": "DIV-02"
    },
